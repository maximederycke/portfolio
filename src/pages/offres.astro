---
import BaseLayout from '../layouts/BaseLayout.astro'
import { PRICES, VAT_NOTICE, eur } from '../lib/prices'

// Déroulé d'un projet, dans l'ordre chronologique : chaque étape a son prix (ou « Offert »).
// Jamais de tarif journalier sur cette page.

interface Price {
  label?: string
  amount: string
}

interface Step {
  title: string
  text: string
  prices: Price[]
  link?: { href: string, label: string }
}

const steps: Step[] = [
  {
    title: 'Rendez-vous de découverte',
    text: 'Trente minutes pour me parler de votre activité et de ce qui coince. Au téléphone, ou sur place dans l\'Oise et les départements voisins.',
    prices: [{ amount: 'Offert' }],
    link: { href: '/contact/', label: 'Prendre rendez-vous' },
  },
  {
    title: 'Étude de projet',
    text: 'Je viens voir comment vous travaillez, au bureau et sur le terrain. J\'écris le cahier des charges, je vous montre une maquette (ou un schéma pour une automatisation), et vous repartez avec un prix ferme pour la première étape.',
    prices: [{ amount: eur(PRICES.etude) }],
  },
  {
    title: 'Première étape utilisable',
    text: 'Une première partie de l\'outil, livrée et prête à servir. Le projet avance ensuite par étapes, chacune à prix ferme, fixé avant qu\'elle commence.',
    prices: [
      { label: 'Automatisation', amount: `à partir de ${eur(PRICES.automatisation)}` },
      { label: 'Application', amount: `à partir de ${eur(PRICES.application)}` },
    ],
  },
  {
    title: 'Évolutions et maintenance',
    text: 'Chaque nouvelle étape est chiffrée avant de commencer. Après les 3 mois de garantie, la maintenance prend le relais : corrections, mises à jour, petits ajustements.',
    prices: [
      { label: 'Automatisation', amount: `à partir de ${eur(PRICES.maintenanceAutomatisation)} / mois` },
      { label: 'Application', amount: `à partir de ${eur(PRICES.maintenanceApplication)} / mois` },
    ],
  },
]

const guarantees = [
  {
    title: 'L\'outil vous appartient',
    text: 'Pas d\'abonnement par utilisateur : vous pouvez ajouter toute l\'équipe sans que la facture grimpe.',
  },
  {
    title: 'Le livrable de l\'Étude est à vous',
    text: 'Cahier des charges et maquette vous restent, même si vous ne signez pas la suite.',
  },
  {
    title: '3 mois de garantie',
    text: 'Inclus après chaque livraison : si quelque chose ne marche pas comme prévu, je corrige sans frais.',
  },
]
---

<BaseLayout
  title="Offres et tarifs — Maxime Derycke"
  description="Planning, interventions, ressaisie entre le terrain et le bureau : un outil sur mesure pour votre PME, livré par étapes à prix ferme. Rendez-vous de découverte offert."
>
  <section class="max-w-3xl mx-auto px-6 py-16 space-y-16">

    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 mb-4">Offres et tarifs</h1>
      <p class="text-zinc-600 leading-relaxed max-w-2xl">
        Le planning dans un tableur, les comptes rendus d'intervention sur papier ou par messages,
        et le bureau qui ressaisit tout ? Je construis l'outil qui relie le terrain au bureau.
        Le projet avance par étapes, et vous connaissez le prix de chacune avant qu'elle commence.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold tracking-tight text-zinc-900 mb-10">Comment se passe un projet</h2>

      <!-- Frise : un rail vertical relie les étapes, numérotées parce que l'ordre compte -->
      <ol class="flex flex-col">
        {steps.map(({ title, text, prices, link }, i) => {
          const isLast = i === steps.length - 1
          return (
            <li class="relative grid grid-cols-[2rem_1fr] gap-x-5 sm:gap-x-6">
              {!isLast && (
                <span class="absolute left-4 top-9 -bottom-1 w-px -translate-x-1/2 bg-zinc-200" aria-hidden="true"></span>
              )}
              <span
                class:list={[
                  'relative flex h-8 w-8 items-center justify-center rounded-full border bg-white font-mono text-xs text-zinc-500',
                  i === 0 ? 'border-teal-500' : 'border-zinc-200',
                ]}
                aria-hidden="true"
              >
                {i + 1}
              </span>

              <div class:list={['pt-1', !isLast && 'pb-12']}>
                <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
                  <h3 class="text-lg font-semibold text-zinc-900">{title}</h3>
                  <dl class="flex flex-col gap-1 sm:items-end sm:text-right shrink-0">
                    {prices.map(({ label, amount }) => (
                      <div class="flex items-baseline gap-2 sm:justify-end">
                        {label && <dt class="font-mono text-xs text-zinc-500">{label}</dt>}
                        <dd class:list={['tabular-nums text-zinc-900', label ? 'text-sm font-medium' : 'text-base font-semibold']}>
                          {amount}
                        </dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <p class="mt-3 text-sm text-zinc-600 leading-relaxed max-w-xl">{text}</p>
                {link && (
                  <a
                    href={link.href}
                    class="inline-flex min-h-11 items-center text-sm font-medium text-zinc-900 hover:text-zinc-500 transition-colors"
                  >
                    {link.label} →
                  </a>
                )}
              </div>
            </li>
          )
        })}
      </ol>

      <p class="mt-10 pl-[3.25rem] sm:pl-14 text-xs text-zinc-500">
        Prix en euros. {VAT_NOTICE}.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold tracking-tight text-zinc-900 mb-6">Trois garanties</h2>
      <ul class="rules">
        {guarantees.map(({ title, text }) => (
          <li class="py-5 sm:grid sm:grid-cols-[14rem_1fr] sm:gap-8">
            <p class="text-sm font-medium text-zinc-900">{title}</p>
            <p class="mt-1.5 sm:mt-0 text-sm text-zinc-500 leading-relaxed">{text}</p>
          </li>
        ))}
      </ul>
    </div>

    <div class="border border-zinc-200 rounded-2xl p-7">
      <h2 class="text-lg font-semibold text-zinc-900 mb-2">On en parle ?</h2>
      <p class="text-sm text-zinc-500 leading-relaxed mb-6">
        Dites-moi ce qui vous fait perdre du temps aujourd'hui. On voit ensemble si un outil peut
        régler le problème, et ce que ça coûterait.
      </p>
      <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5">
        <a
          href="/contact/"
          class="inline-flex px-5 py-3 sm:py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 active:translate-y-px transition"
        >
          Prendre rendez-vous
        </a>
        <span class="font-mono text-xs text-zinc-500">30 min offertes</span>
      </div>
    </div>

  </section>
</BaseLayout>
