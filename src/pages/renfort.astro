---
import BaseLayout from '../layouts/BaseLayout.astro'
import Malt from '../components/icons/Malt.astro'

// Page du public secondaire (équipes techniques) : hors du menu, liée depuis le pied de page.
// Jamais de tarif ici, et les preuves restent anonymes (dépôt public).

const missions = [
  'Conception : découper le besoin avant de coder, pour un code qui reste maintenable',
  'Développement fullstack TypeScript, du front à l\'API',
  'Reprise d\'une application existante, pour la stabiliser et la faire évoluer',
]

const stack = [
  'TypeScript', 'React', 'React Native / Expo', 'Node.js', 'NestJS', 'AdonisJS',
  'PostgreSQL', 'Docker', 'AWS',
]

const proofs = [
  {
    date: '2026',
    title: 'Mission freelance',
    text: 'Outil de planification pour les techniciens d\'une entreprise de services numériques. Ils jonglaient entre Jira, Tempo, Outlook et un ERP ; l\'outil réunit tout : planning de l\'équipe sur une seule vue, saisie des temps plus rapide, tickets, rendez-vous et congés affichés dans le planning.',
    tech: 'React 19 · Bun · Hono · Docker · API Jira · Tempo · Microsoft Graph',
  },
  {
    date: '2022 — 2026',
    title: 'En poste',
    text: 'Application mobile de mise en service pour des installateurs de chauffage. Ils scannent l\'étiquette de l\'appareil, remplissent un formulaire adapté au modèle, et les données partent dans l\'ERP du fabricant sans ressaisie.',
    tech: 'React Native (Expo) · NestJS · AWS',
  },
]

const ways = [
  'Autonome à distance, avec des points réguliers',
  'Du code pensé pour durer : architecture claire, typage de bout en bout',
  'Tout le cycle, de la conception au suivi en production',
  'Échanges directs avec les utilisateurs',
  'Une rigueur héritée de 3 ans de validation de logiciels embarqués dans l\'automobile',
]

const email = 'maxime@mdigitalstudio.fr'
const mailto = `mailto:${email}?subject=${encodeURIComponent('Renfort technique')}`

const eyebrow = 'text-xs font-mono text-zinc-500 uppercase tracking-widest'
---

<BaseLayout
  title="Renfort technique — Maxime Derycke"
  description="Développeur fullstack TypeScript en renfort d'une équipe technique : applications web et mobile en production, conception, reprise de l'existant."
>
  <section class="max-w-3xl mx-auto px-6 py-16 space-y-14">

    <!-- Renvoi pour le dirigeant arrivé ici par erreur -->
    <p class="text-sm text-zinc-500">
      Vous dirigez une PME et cherchez un outil pour vos équipes ?
      <a href="/offres/" class="py-3 font-medium whitespace-nowrap text-zinc-900 hover:text-zinc-500 transition-colors">Offres et tarifs →</a>
    </p>

    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-zinc-900 mb-4">Renfort technique</h1>
      <p class="text-zinc-600 leading-relaxed">
        Je rejoins votre équipe pour faire évoluer une application web ou mobile déjà en production.
      </p>
    </div>

    <div>
      <h2 class={`${eyebrow} mb-6`}>Missions</h2>
      <ul class="flex flex-col gap-3 text-sm text-zinc-600">
        {missions.map(item => (
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 text-zinc-300" aria-hidden="true">—</span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class={`${eyebrow} mb-5`}>Stack</h2>
      <ul class="flex flex-wrap gap-2">
        {stack.map(tech => (
          <li class="text-xs font-mono px-3 py-1 rounded-full border border-zinc-200 text-zinc-500">
            {tech}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class={`${eyebrow} mb-8`}>Réalisations</h2>
      <div class="flex flex-col gap-8">
        {proofs.map(({ date, title, text, tech }) => (
          <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
            <span class="text-xs font-mono text-zinc-500 sm:w-24 shrink-0 sm:pt-0.5">{date}</span>
            <div>
              <p class="text-sm font-medium text-zinc-900">{title}</p>
              <p class="text-sm text-zinc-500 mt-1.5 leading-relaxed">{text}</p>
              <p class="text-xs font-mono text-zinc-500 mt-2.5">{tech}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div>
      <h2 class={`${eyebrow} mb-6`}>Façon de travailler</h2>
      <ul class="flex flex-col gap-3 text-sm text-zinc-600">
        {ways.map(item => (
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 text-zinc-300" aria-hidden="true">—</span>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class={`${eyebrow} mb-5`}>Disponibilité</h2>
      <p class="text-zinc-600 leading-relaxed">
        2 à 3 jours par semaine, ou à temps plein sur une mission de 3 à 6 mois.
        À distance, ou sur site à Beauvais et dans les environs.
      </p>
    </div>

    <div class="border border-zinc-200 rounded-2xl p-7">
      <h2 class={`${eyebrow} mb-3`}>Contact</h2>
      <p class="text-sm text-zinc-500 leading-relaxed mb-6">
        Décrivez-moi le contexte de l'équipe et la mission, je vous réponds rapidement.
      </p>
      <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-6">
        <a
          href={mailto}
          class="inline-flex px-5 py-3 sm:py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 active:translate-y-px transition"
        >
          Écrire un e-mail
        </a>
        <a
          href="https://www.malt.fr/profile/maximederycke"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 text-sm text-zinc-500 hover:text-zinc-600 transition-colors"
        >
          <Malt size={18} />
          Voir mon profil Malt →
        </a>
      </div>
    </div>

  </section>
</BaseLayout>
