---
import BaseLayout from '../layouts/BaseLayout.astro'
import Malt from '../components/icons/Malt.astro'
import Page from '../components/Page.astro'
import PageIntro from '../components/PageIntro.astro'
import Section from '../components/Section.astro'
import ArrowLink from '../components/ArrowLink.astro'
import ContactCard from '../components/ContactCard.astro'
import { body, bullet } from '../lib/typography'

// Page du public secondaire (équipes techniques) : hors du menu, liée depuis le pied de page.
// Jamais de tarif ici, et les preuves restent anonymes (dépôt public).

const missions = [
  'Conception : découper le besoin avant de coder, pour un code qui reste maintenable',
  'Développement fullstack TypeScript, du front à l\'API',
  'Reprise d\'une application existante, pour la stabiliser et la faire évoluer',
]

const stack = [
  'TypeScript', 'React', 'React Native / Expo', 'Node.js', 'NestJS', 'AdonisJS',
  'PostgreSQL', 'Docker', 'AWS',
]

const proofs = [
  {
    date: '2026',
    title: 'Mission freelance',
    text: 'Outil de planification pour les techniciens d\'une entreprise de services numériques. Ils jonglaient entre Jira, Tempo, Outlook et un ERP ; l\'outil réunit tout : planning de l\'équipe sur une seule vue, saisie des temps plus rapide, tickets, rendez-vous et congés affichés dans le planning.',
    tech: 'React 19 · Bun · Hono · Docker · API Jira · Tempo · Microsoft Graph',
  },
  {
    date: '2022 — 2026',
    title: 'En poste',
    text: 'Application mobile de mise en service pour des installateurs de chauffage. Ils scannent l\'étiquette de l\'appareil, remplissent un formulaire adapté au modèle, et les données partent dans l\'ERP du fabricant sans ressaisie.',
    tech: 'React Native (Expo) · NestJS · AWS',
  },
]

const ways = [
  'Autonome à distance, avec des points réguliers',
  'Du code pensé pour durer : architecture claire, typage de bout en bout',
  'Tout le cycle, de la conception au suivi en production',
  'Échanges directs avec les utilisateurs',
  'Une rigueur héritée de 3 ans de validation de logiciels embarqués dans l\'automobile',
]

const email = 'maxime@mdigitalstudio.fr'
const mailto = `mailto:${email}?subject=${encodeURIComponent('Renfort technique')}`
---

<BaseLayout
  title="Renfort technique — Maxime Derycke"
  description="Développeur fullstack TypeScript en renfort d'une équipe technique : applications web et mobile en production, conception, reprise de l'existant."
>
  <Page>

    <PageIntro title="Renfort technique">
      <p>Je rejoins votre équipe pour faire évoluer une application web ou mobile déjà en production.</p>
      <!-- Renvoi pour le dirigeant arrivé ici par erreur : sous le chapeau, pour ne pas décaler le titre -->
      <p slot="after" class="mt-6 flex flex-wrap items-center gap-x-2 text-sm text-zinc-500">
        Vous dirigez une PME et cherchez un outil pour vos équipes ?
        <ArrowLink href="/offres/">Offres et tarifs</ArrowLink>
      </p>
    </PageIntro>

    <Section title="Missions">
      <ul class="flex flex-col gap-3 text-zinc-600">
        {missions.map(item => (
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class={bullet}></span>
            {item}
          </li>
        ))}
      </ul>
    </Section>

    <Section title="Stack">
      <ul class="flex flex-wrap gap-2">
        {stack.map(tech => (
          <li class="text-xs font-mono px-3 py-1 rounded-full border border-zinc-200 text-zinc-500">
            {tech}
          </li>
        ))}
      </ul>
    </Section>

    <Section title="Réalisations">
      <ol class="divide-y divide-zinc-100">
        {proofs.map(({ date, title, text, tech }) => (
          <li class="flex flex-col gap-2 py-6 first:pt-0 last:pb-0 sm:flex-row sm:gap-8">
            <span class="shrink-0 font-mono text-xs text-zinc-500 sm:w-28 sm:pt-1">{date}</span>
            <div>
              <p class="font-medium text-zinc-900">{title}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600">{text}</p>
              <p class="mt-3 font-mono text-xs text-zinc-500">{tech}</p>
            </div>
          </li>
        ))}
      </ol>
    </Section>

    <Section title="Façon de travailler">
      <ul class="flex flex-col gap-3 text-zinc-600">
        {ways.map(item => (
          <li class="flex items-start gap-3">
            <span aria-hidden="true" class={bullet}></span>
            {item}
          </li>
        ))}
      </ul>
    </Section>

    <Section title="Disponibilité">
      <p class={body}>
        2 à 3 jours par semaine, ou à temps plein sur une mission de 3 à 6 mois.
        À distance, ou sur site à Beauvais et dans les environs.
      </p>
    </Section>

    <ContactCard
      title="Parlons de votre mission"
      text="Décrivez-moi le contexte de l'équipe et la mission, je vous réponds rapidement."
    >
      <div slot="actions" class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:gap-6">
        <a
          href={mailto}
          class="inline-flex min-h-11 items-center rounded-lg bg-zinc-900 px-5 text-sm font-medium text-white transition-colors duration-200 hover:bg-zinc-700 active:translate-y-px"
        >
          Écrire un e-mail
        </a>
        <a
          href="https://www.malt.fr/profile/maximederycke"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-zinc-900 decoration-zinc-900/30 underline-offset-4 hover:underline"
        >
          <Malt size={18} />
          Voir mon profil Malt
        </a>
      </div>
    </ContactCard>

  </Page>
</BaseLayout>
