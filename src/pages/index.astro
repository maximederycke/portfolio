---
import BaseLayout from '../layouts/BaseLayout.astro'
import SocialLinks from '../components/SocialLinks.astro'

const builds = [
  { title: 'Applications web', detail: 'SPA, dashboards, outils internes' },
  { title: 'Applications mobile', detail: 'React Native / Expo' },
  { title: 'Intégrations', detail: 'API REST & OAuth2 — Jira, Microsoft Graph, ERP…' },
  { title: 'Déploiement', detail: 'Environnements Docker et mise en production' },
]

const stack = [
  { label: 'Web', value: 'TypeScript · React · Node.js' },
  { label: 'Mobile', value: 'React Native · Expo' },
  { label: 'Données', value: 'PostgreSQL · Docker' },
]
---

<BaseLayout
  title="Maxime Derycke — Développeur Fullstack JS/TS"
  description="Maxime Derycke, développeur fullstack TypeScript freelance : applications web et mobile sur mesure pour les PME, de l'UX à la mise en production."
>
  <div class="relative isolate">

    <!-- Grille SVG — remonte derrière le header fixe -->
    <svg
      aria-hidden="true"
      class="absolute inset-x-0 -top-20 -z-10 h-224 w-full mask-[radial-gradient(20rem_20rem_at_60%_40%,white,transparent)] sm:mask-[radial-gradient(40rem_40rem_at_60%_40%,white,transparent)] stroke-zinc-200"
    >
      <defs>
        <pattern id="grid" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
          <path d="M.5 200V.5H200" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" stroke-width="0" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pt-24 pb-24 sm:pt-32 lg:px-8 lg:pt-36">
      <div class="max-w-2xl gap-x-14 lg:flex lg:max-w-none lg:items-center lg:justify-between">

        <!-- Texte gauche -->
        <div class="relative w-full lg:max-w-xl lg:shrink-0 xl:max-w-2xl">
          <p class="mb-5 flex items-center gap-2.5 text-sm font-mono text-zinc-600">
            <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500"></span>
            Disponible pour de nouvelles missions
          </p>
          <h1 class="text-4xl font-semibold tracking-tight text-balance text-zinc-900 sm:text-5xl">
            Applications web et mobile sur mesure pour les PME
          </h1>
          <p class="mt-4 text-xl text-balance text-zinc-500">
            Maxime Derycke, développeur fullstack TypeScript freelance · 100&nbsp;% à distance
          </p>
          <p class="mt-6 text-base text-zinc-500 leading-relaxed sm:max-w-md lg:max-w-none">
            De la réflexion UX à la mise en production : outils internes, applications mobiles,
            intégrations d'ERP et d'API tierces. Basé à Beauvais.
          </p>
          <div class="mt-10 flex items-center gap-x-5">
            <a
              href="/contact"
              class="px-5 py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors"
            >
              Démarrer un projet
            </a>
            <SocialLinks size={20} />
          </div>
        </div>

        <!-- Note en marge : la pile technique, en clair -->
        <dl class="mt-14 border-l border-zinc-200 pl-6 font-mono text-sm lg:mt-0 lg:w-72 lg:shrink-0">
          {stack.map(({ label, value }) => (
            <div class="py-3 first:pt-0 last:pb-0">
              <dt class="text-xs text-zinc-500">{label}</dt>
              <dd class="mt-1 text-zinc-900">{value}</dd>
            </div>
          ))}
        </dl>

      </div>
    </div>

  </div>

  <!-- Qui je suis + chiffres -->
  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 sm:py-20">
    <div class="max-w-2xl lg:max-w-none">
      <h2 class="text-3xl font-semibold tracking-tight text-zinc-900 mb-10">Avec qui vous travaillez</h2>
      <div class="flex flex-col gap-x-8 gap-y-16 lg:flex-row">
        <div class="lg:w-full lg:max-w-2xl lg:flex-auto">
          <p class="text-xl text-zinc-600 leading-relaxed">
            Je prends en charge vos projets de bout en bout, avec autant d'attention
            à la qualité du code qu'à l'expérience utilisateur.
          </p>
          <p class="mt-6 text-base text-zinc-500 leading-relaxed max-w-xl">
            Je travaille à distance avec des clients partout en France, avec des déplacements
            ponctuels possibles en Île-de-France et Hauts-de-France. Réactif, transparent sur
            l'avancement, et impliqué au-delà du seul périmètre technique.
          </p>
        </div>
        <div class="lg:flex lg:flex-auto lg:justify-center">
          <dl class="w-64 space-y-8 xl:w-72">
            <div class="flex flex-col-reverse gap-y-1">
              <dt class="text-sm text-zinc-500">D'expérience en développement web</dt>
              <dd class="text-5xl font-semibold tracking-tight text-zinc-900">4 ans</dd>
            </div>
            <div class="flex flex-col-reverse gap-y-1">
              <dt class="text-sm text-zinc-500">Délai de réponse habituel</dt>
              <dd class="text-5xl font-semibold tracking-tight text-zinc-900">48h</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </div>

  <!-- Ce que je construis -->
  <section class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <h2 class="text-xl font-semibold text-zinc-900 mb-8">Ce que je construis</h2>
    <ul class="max-w-2xl divide-y divide-zinc-100 border-y border-zinc-100">
      {builds.map(({ title, detail }) => (
        <li class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-8">
          <span class="text-sm font-medium text-zinc-900 sm:w-48 sm:shrink-0">{title}</span>
          <span class="text-sm text-zinc-500">{detail}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Services en bref -->
  <section class="mx-auto max-w-7xl px-6 lg:px-8 py-16">
    <div class="flex items-baseline justify-between mb-8">
      <h2 class="text-xl font-semibold text-zinc-900">Comment je travaille</h2>
      <a href="/services" class="text-sm text-zinc-500 hover:text-zinc-600 transition-colors">Voir les services →</a>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="border border-zinc-200 rounded-2xl p-6">
        <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Agile</span>
        <p class="text-sm text-zinc-500 leading-relaxed mt-3">
          Tarif journalier fixe, livraisons toutes les 2 semaines. Le budget total reste indicatif :
          on ajuste les priorités à chaque cycle.
        </p>
      </div>

      <div class="border border-zinc-200 rounded-2xl p-6 bg-zinc-50">
        <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Forfait</span>
        <p class="text-sm text-zinc-500 leading-relaxed mt-3">
          Périmètre et prix fixés en amont. Idéal si vous avez besoin de visibilité budgétaire sur une mission définie.
        </p>
      </div>
    </div>
  </section>

  <!-- Prochaine étape -->
  <section class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 pb-24">
    <div class="max-w-2xl border-t border-zinc-100 pt-16">
      <h2 class="text-3xl font-semibold tracking-tight text-zinc-900">Un projet à discuter ?</h2>
      <p class="mt-3 text-zinc-500">
        Quelques questions, deux minutes : je reviens vers vous rapidement.
      </p>
      <a
        href="/contact"
        class="mt-8 inline-flex px-5 py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors"
      >
        Démarrer un projet
      </a>
    </div>
  </section>

</BaseLayout>
