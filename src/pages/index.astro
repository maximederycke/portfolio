---
import BaseLayout from '../layouts/BaseLayout.astro'
import SocialLinks from '../components/SocialLinks.astro'
import Avatar from '../components/Avatar.astro'
import Section from '../components/Section.astro'
import ArrowLink from '../components/ArrowLink.astro'
import ContactCard from '../components/ContactCard.astro'
import { h1 } from '../lib/typography'

// L'accueil parle au dirigeant de PME : son problème, son territoire, le déroulé, une preuve.
// Aucun jargon technique ici (il vit sur /renfort/), aucun prix détaillé (il vit sur /offres/).

const needs = [
  { title: 'Planning des interventions', detail: 'Qui intervient où et quand, sur une seule vue partagée par toute l\'équipe.' },
  { title: 'Bons d\'intervention sur mobile', detail: 'Photos, signature du client, même sans réseau.' },
  { title: 'Remontée des informations', detail: 'Ce qui est saisi sur le terrain arrive au bureau, sans ressaisie.' },
  { title: 'Connexion avec vos logiciels', detail: 'Vos outils actuels restent en place et se parlent entre eux.' },
]

const means = [
  { title: 'Une automatisation', detail: 'Je relie les outils que vous utilisez déjà, pour que l\'information passe de l\'un à l\'autre.' },
  { title: 'Une application sur mesure', detail: 'Un outil web ou mobile construit pour votre façon de travailler. Il vous appartient.' },
]

const steps = [
  { title: 'Rendez-vous de découverte', detail: '30 minutes, au téléphone ou sur place.' },
  { title: 'Étude de projet', detail: 'Je viens voir le terrain, puis je rédige le cahier des charges et le prix ferme de la première étape.' },
  { title: 'Première étape utilisable', detail: 'Une première partie de l\'outil, livrée et facturée au prix fixé avant de commencer.' },
  { title: 'Évolutions et maintenance', detail: 'Chaque nouvelle étape est chiffrée avant de démarrer. La maintenance prend le relais des 3 mois de garantie.' },
]

// Carte « Parcours » : inchangée ici, elle relève du ticket À propos.
const career = [
  { title: 'Développeur freelance', detail: 'Hub de planification pour une ESN', dates: 'Depuis 2026' },
  { title: 'Développeur fullstack — CDI', detail: 'Applications web et mobile', dates: '2022 — 2026' },
  { title: "Technicien d'essais & intégration véhicule", detail: 'Industrie automobile', dates: '2017 — 2021' },
]

const primaryButton =
  'group/cta inline-flex min-h-11 items-center gap-1.5 rounded-lg bg-zinc-900 pr-4 pl-5 text-sm font-medium text-white transition-colors duration-200 hover:bg-zinc-700 active:translate-y-px'
---

<BaseLayout
  title="Outils sur mesure pour les PME avec des équipes terrain · Beauvais (Oise) — Maxime Derycke"
  description="Planning, bons d'intervention, remontée des informations : des outils sur mesure pour les PME avec des équipes terrain, sans ressaisie. Depuis Beauvais (Oise)."
>
  <div class="relative isolate">

    {/* Grille du hero, remontée derrière l'en-tête fixe. Masquée sous sm : sur un écran
        étroit, ses traits passeraient forcément derrière le titre. */}
    <svg
      aria-hidden="true"
      class="sweep-in grid-fade absolute inset-x-0 -top-16 -z-10 hidden h-[calc(100%+4rem)] w-full stroke-zinc-200 sm:block"
    >
      <defs>
        <pattern id="grid" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
          <path d="M.5 200V.5H200" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" stroke-width="0" />
    </svg>

    <div class="grid gap-y-14 px-6 pt-16 pb-16 sm:pt-24 lg:grid-cols-12 lg:items-center lg:gap-x-8 lg:px-8 lg:pt-28 lg:pb-24">

      <div class="lg:col-span-7">
        <Avatar class="set-in mb-8" />
        <p class="set-in mb-5 flex items-center gap-2.5 font-mono text-xs text-zinc-600" style="--i:0">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500"></span>
          Disponible pour de nouveaux projets
        </p>
        <h1 class:list={['set-in', h1]} style="--i:1">
          Du terrain au bureau, sans rien ressaisir.
        </h1>
        <p class="set-in mt-6 max-w-xl text-lg leading-relaxed text-pretty text-zinc-600 sm:text-xl" style="--i:2">
          J'aide les PME qui ont des équipes sur le terrain à simplifier leur planning, leurs interventions
          et la remontée des informations. Je conçois et je développe moi-même vos outils,
          depuis <span class="font-medium text-zinc-900">Beauvais (Oise)</span>.
        </p>
        <div class="set-in mt-10 flex flex-wrap items-start gap-x-5 gap-y-4" style="--i:3">
          <div class="flex flex-col items-start gap-3">
            <a href="/contact/" class={primaryButton}>
              Prendre rendez-vous
              <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 transition-transform duration-300 ease-out group-hover/cta:translate-x-0.5 motion-reduce:transition-none">
                <path d="M3.5 8h9M8.75 4.25 12.5 8l-3.75 3.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <span class="font-mono text-xs text-zinc-500">30 min, au téléphone ou sur place</span>
          </div>
          <SocialLinks size={20} class="-ml-3 sm:ml-0" />
        </div>
      </div>

      {/* Seule preuve réalisée en indépendant, anonymisée (dépôt public : aucun nom de client).
          Le bloc gris, opaque, coupe la grille au lieu de la laisser passer derrière le texte. */}
      <section aria-labelledby="case-title" class="set-in rounded-2xl border border-zinc-200 bg-zinc-50 p-7 sm:p-8 lg:col-span-5" style="--i:4">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 id="case-title" class="text-xl font-semibold text-zinc-900">Avant / après</h2>
          <p class="font-mono text-xs text-zinc-500">Mission freelance, 2026</p>
        </div>
        <dl class="mt-6 space-y-5">
          <div>
            <dt class="font-mono text-xs text-zinc-500">Avant</dt>
            <dd class="mt-1.5 leading-relaxed text-zinc-600">
              Les techniciens d'une entreprise de services jonglaient entre quatre outils
              pour planifier leurs interventions et saisir leurs temps.
            </dd>
          </div>
          <div>
            <dt class="flex items-center gap-2 font-mono text-xs text-zinc-500">
              <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500"></span>
              Après
            </dt>
            <dd class="mt-1.5 leading-relaxed text-zinc-900">
              Un planning de toute l'équipe sur une seule vue, une saisie des temps en quelques clics,
              les rendez-vous et les congés affichés directement.
            </dd>
          </div>
        </dl>
      </section>

    </div>
  </div>

  <div class="px-6 pb-24 lg:px-8">

    <Section title="Ce que je construis">
      <ul class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {needs.map(({ title, detail }) => (
          <li class="border-t border-zinc-200 pt-4">
            <p class="font-medium text-zinc-900">{title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-600">{detail}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section title="Deux moyens">
      <p class="mb-6 text-zinc-600">Selon votre situation :</p>
      <div class="grid gap-6 sm:grid-cols-2 sm:gap-0 sm:divide-x sm:divide-zinc-200">
        {means.map(({ title, detail }, i) => (
          <div class:list={[i === 0 ? 'sm:pr-8' : 'sm:pl-8']}>
            <p class="text-xl font-semibold text-zinc-900">{title}</p>
            <p class="mt-2 leading-relaxed text-pretty text-zinc-600">{detail}</p>
          </div>
        ))}
      </div>
    </Section>

    <Section title="Comment je travaille">
      {/* Même frise que /offres/ : numérotée parce que l'ordre compte */}
      <ol class="flex flex-col">
        {steps.map(({ title, detail }, i) => {
          const isLast = i === steps.length - 1
          return (
            <li class="relative grid grid-cols-[2rem_1fr] gap-x-5 sm:gap-x-6">
              {!isLast && (
                <span class="absolute top-9 -bottom-1 left-4 w-px -translate-x-1/2 bg-zinc-200" aria-hidden="true"></span>
              )}
              <span
                class:list={[
                  'relative flex size-8 items-center justify-center rounded-full border bg-white font-mono text-xs text-zinc-500',
                  i === 0 ? 'border-teal-500' : 'border-zinc-200',
                ]}
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <div class:list={['pt-1', !isLast && 'pb-8']}>
                <p class="font-medium text-zinc-900">{title}</p>
                <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-pretty text-zinc-600">{detail}</p>
              </div>
            </li>
          )
        })}
      </ol>
      <ArrowLink href="/offres/" class="mt-6">Voir les offres et tarifs</ArrowLink>
    </Section>

    <Section title="Parcours">
      <ol class="divide-y divide-zinc-100">
        {career.map(({ title, detail, dates }) => (
          <li class="flex flex-col gap-1 py-4 first:pt-0 sm:flex-row sm:items-baseline sm:gap-8">
            <span class="shrink-0 font-mono text-xs text-zinc-500 sm:w-28">{dates}</span>
            <p class="text-zinc-900">
              <span class="font-medium">{title}</span>
              <span class="text-zinc-500"> · {detail}</span>
            </p>
          </li>
        ))}
      </ol>
      <ArrowLink href="/about/" class="mt-4">Voir le parcours complet</ArrowLink>
    </Section>

    <ContactCard
      title="Un projet à discuter ?"
      text="Décrivez votre besoin en quelques questions. Je vous rappelle sous 48 h ouvrées."
    />

  </div>

</BaseLayout>
