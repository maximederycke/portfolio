---
import BaseLayout from '../layouts/BaseLayout.astro'
import SocialLinks from '../components/SocialLinks.astro'
import Avatar from '../components/Avatar.astro'

const builds = [
  { title: 'Applications web', detail: 'SPA, dashboards, outils internes' },
  { title: 'Applications mobile', detail: 'React Native / Expo' },
  { title: 'Intégrations', detail: 'API REST & OAuth2 — Jira, Microsoft Graph, ERP…' },
  { title: 'Déploiement', detail: 'Environnements Docker et mise en production' },
]

const career = [
  { title: 'Développeur freelance', detail: 'Hub de planification pour une ESN', dates: 'Depuis 2026' },
  { title: 'Développeur fullstack — CDI', detail: 'Applications web et mobile', dates: '2022 — 2026' },
  { title: "Technicien d'essais & intégration véhicule", detail: 'Industrie automobile', dates: '2017 — 2021' },
]
---

<BaseLayout
  title="Maxime Derycke — Développeur Fullstack JS/TS"
  description="Maxime Derycke, développeur fullstack TypeScript freelance : applications web et mobile sur mesure pour les PME, de l'UX à la mise en production."
>
  <div class="relative isolate">

    <!-- Grille SVG — remonte derrière le header fixe -->
    <svg
      aria-hidden="true"
      class="sweep-in grid-fade absolute inset-x-0 -top-16 -z-10 h-[calc(100%+4rem)] w-full stroke-zinc-200"
    >
      <defs>
        <pattern id="grid" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
          <path d="M.5 200V.5H200" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" stroke-width="0" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pt-24 pb-24 sm:pt-32 lg:px-8 lg:pt-36">
      <div class="max-w-2xl lg:max-w-none">

        <div class="relative w-full lg:max-w-xl xl:max-w-2xl">
          <Avatar class="set-in mb-8" />
          <p class="set-in mb-5 flex items-center gap-2.5 text-sm font-mono text-zinc-600" style="--i:0">
            <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500"></span>
            Disponible pour de nouvelles missions
          </p>
          <h1 class="set-in text-4xl font-semibold tracking-tight text-balance text-zinc-900 sm:text-5xl" style="--i:1">
            Applications web et mobile sur mesure pour les PME
          </h1>
          <p class="set-in mt-4 text-xl text-balance text-zinc-500" style="--i:2">
            Maxime Derycke, développeur fullstack TypeScript freelance · 100&nbsp;% à distance
          </p>
          <p class="set-in mt-6 text-base text-zinc-500 leading-relaxed sm:max-w-md lg:max-w-none" style="--i:3">
            De la réflexion UX à la mise en production : outils internes, applications mobiles,
            intégrations d'ERP et d'API tierces. Basé à Beauvais.
          </p>
          <div class="set-in mt-10 flex items-center gap-x-5" style="--i:4">
            <a
              href="/contact"
              class="px-5 py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors"
            >
              Démarrer un projet
            </a>
            <SocialLinks size={20} />
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Contenu : à gauche le travail, à droite les cartes de repère -->
  <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 pb-24">
    <div class="grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2">

      <div class="flex flex-col gap-16">

        <section>
          <h2 class="text-xl font-semibold text-zinc-900">Avec qui vous travaillez</h2>
          <p class="mt-4 text-lg text-zinc-600 leading-relaxed">
            Je prends en charge vos projets de bout en bout, avec autant d'attention
            à la qualité du code qu'à l'expérience utilisateur.
          </p>
          <p class="mt-4 text-base text-zinc-500 leading-relaxed">
            Je travaille à distance avec des clients partout en France, avec des déplacements
            ponctuels possibles en Île-de-France et Hauts-de-France. Réactif, transparent sur
            l'avancement, et impliqué au-delà du seul périmètre technique.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-semibold text-zinc-900 mb-6">Ce que je construis</h2>
          <ul class="rules">
            {builds.map(({ title, detail }) => (
              <li class="flex flex-col gap-1 py-4 sm:flex-row sm:gap-6">
                <span class="text-sm font-medium text-zinc-900 sm:w-40 sm:shrink-0">{title}</span>
                <span class="text-sm text-zinc-500">{detail}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="text-xl font-semibold text-zinc-900">Comment je travaille</h2>
            <a href="/services" class="text-sm text-zinc-500 hover:text-zinc-600 transition-colors">Voir les services →</a>
          </div>
          <div class="flex flex-col gap-4">
            <div class="border border-zinc-200 rounded-2xl p-6">
              <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Agile</span>
              <p class="text-sm text-zinc-500 leading-relaxed mt-3">
                Tarif journalier fixe, livraisons toutes les 2 semaines. Le budget total reste indicatif :
                on ajuste les priorités à chaque cycle.
              </p>
            </div>
            <div class="border border-zinc-200 rounded-2xl p-6 bg-zinc-50">
              <span class="text-xs font-mono text-zinc-500 uppercase tracking-widest">Forfait</span>
              <p class="text-sm text-zinc-500 leading-relaxed mt-3">
                Périmètre et prix fixés en amont. Idéal si vous avez besoin de visibilité budgétaire sur une mission définie.
              </p>
            </div>
          </div>
        </section>

      </div>

      <div class="space-y-10 lg:pl-16 xl:pl-24">

        <section class="rounded-2xl border border-zinc-200 p-6">
          <h2 class="flex items-center gap-3 text-sm font-semibold text-zinc-900">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 flex-none text-zinc-400">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
              <path d="M3 13h18" />
            </svg>
            Parcours
          </h2>
          <ol class="mt-6 space-y-4">
            {career.map(({ title, detail, dates }) => (
              <li class="flex gap-4">
                <div class="flex-auto">
                  <p class="text-sm font-medium text-zinc-900">{title}</p>
                  <p class="mt-0.5 text-xs text-zinc-500">{detail}</p>
                </div>
                <span class="flex-none pt-0.5 font-mono text-xs text-zinc-500">{dates}</span>
              </li>
            ))}
          </ol>
          <dl class="mt-6 grid grid-cols-2 gap-4 border-t border-zinc-100 pt-6">
            <div class="flex flex-col-reverse gap-y-1">
              <dt class="text-xs text-zinc-500">D'expérience en développement web</dt>
              <dd class="text-2xl font-semibold tracking-tight text-zinc-900">4 ans</dd>
            </div>
            <div class="flex flex-col-reverse gap-y-1">
              <dt class="text-xs text-zinc-500">Délai de réponse habituel</dt>
              <dd class="text-2xl font-semibold tracking-tight text-zinc-900">48h</dd>
            </div>
          </dl>
          <a href="/about" class="mt-6 inline-block text-sm text-zinc-500 hover:text-zinc-600 transition-colors">
            Voir le parcours complet →
          </a>
        </section>

        <section class="rounded-2xl border border-zinc-200 p-6">
          <h2 class="flex items-center gap-3 text-sm font-semibold text-zinc-900">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 flex-none text-zinc-400">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            Un projet à discuter ?
          </h2>
          <p class="mt-3 text-sm text-zinc-500 leading-relaxed">
            Quelques questions, deux minutes : je reviens vers vous rapidement.
          </p>
          <a
            href="/contact"
            class="mt-6 flex w-full justify-center px-5 py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 transition-colors"
          >
            Démarrer un projet
          </a>
        </section>

      </div>
    </div>
  </div>

</BaseLayout>
