---
import BaseLayout from '../layouts/BaseLayout.astro'
import SocialLinks from '../components/SocialLinks.astro'
import Avatar from '../components/Avatar.astro'

// L'accueil parle au dirigeant de PME : son problème, son territoire, le déroulé, une preuve.
// Aucun jargon technique ici (il vit sur /renfort/), aucun prix détaillé (il vit sur /offres/).

const needs = [
  { title: 'Planning des interventions', detail: 'Qui intervient où et quand, sur une seule vue partagée par toute l\'équipe.' },
  { title: 'Bons d\'intervention sur mobile', detail: 'Photos, signature du client, même sans réseau.' },
  { title: 'Remontée des informations', detail: 'Ce qui est saisi sur le terrain arrive au bureau, sans ressaisie.' },
  { title: 'Connexion avec vos logiciels', detail: 'Vos outils actuels restent en place et se parlent entre eux.' },
]

const means = [
  { title: 'Une automatisation', detail: 'Je relie les outils que vous utilisez déjà, pour que l\'information passe de l\'un à l\'autre.' },
  { title: 'Une application sur mesure', detail: 'Un outil web ou mobile construit pour votre façon de travailler. Il vous appartient.' },
]

const steps = [
  { title: 'Rendez-vous de découverte', detail: '30 minutes, au téléphone ou sur place.' },
  { title: 'Étude de projet', detail: 'Je viens voir le terrain, puis je rédige le cahier des charges et le prix ferme de la première étape.' },
  { title: 'Première étape utilisable', detail: 'Une première partie de l\'outil, livrée et facturée au prix fixé avant de commencer.' },
  { title: 'Évolutions et maintenance', detail: 'Chaque nouvelle étape est chiffrée avant de démarrer. La maintenance prend le relais des 3 mois de garantie.' },
]

// Carte « Parcours » : inchangée ici, elle relève du ticket À propos.
const career = [
  { title: 'Développeur freelance', detail: 'Hub de planification pour une ESN', dates: 'Depuis 2026' },
  { title: 'Développeur fullstack — CDI', detail: 'Applications web et mobile', dates: '2022 — 2026' },
  { title: "Technicien d'essais & intégration véhicule", detail: 'Industrie automobile', dates: '2017 — 2021' },
]

const primaryButton =
  'justify-center px-5 py-3 sm:py-2.5 bg-zinc-900 text-white text-sm font-medium rounded-lg hover:bg-zinc-700 active:translate-y-px transition'
const textLink =
  '-my-3 inline-flex min-h-11 items-center text-sm text-zinc-500 hover:text-zinc-600 transition-colors'
---

<BaseLayout
  title="Outils sur mesure pour les PME avec des équipes terrain · Beauvais (Oise) — Maxime Derycke"
  description="Planning, bons d'intervention, remontée des informations : des outils sur mesure pour les PME avec des équipes terrain, sans ressaisie. Depuis Beauvais (Oise)."
>
  <div class="relative isolate">

    {/* Grille SVG — remonte derrière le header fixe */}
    <svg
      aria-hidden="true"
      class="sweep-in grid-fade absolute inset-x-0 -top-16 -z-10 h-[calc(100%+4rem)] w-full stroke-zinc-200"
    >
      <defs>
        <pattern id="grid" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
          <path d="M.5 200V.5H200" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)" stroke-width="0" />
    </svg>

    <div class="mx-auto max-w-7xl px-6 pt-24 pb-24 sm:pt-32 lg:px-8 lg:pt-36 lg:pb-32">
      <div class="max-w-2xl lg:max-w-none">

        <div class="relative w-full lg:max-w-xl xl:max-w-2xl">
          <Avatar class="set-in mb-8" />
          <p class="set-in mb-5 flex items-center gap-2.5 text-sm font-mono text-zinc-600" style="--i:0">
            <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500"></span>
            Disponible pour de nouveaux projets
          </p>
          <h1 class="set-in text-4xl font-semibold tracking-tight text-balance text-zinc-900 sm:text-5xl" style="--i:1">
            Du terrain au bureau, sans rien ressaisir.
          </h1>
          <p class="set-in mt-6 max-w-xl text-lg text-pretty text-zinc-500 leading-relaxed sm:text-xl" style="--i:2">
            J'aide les PME qui ont des équipes sur le terrain à simplifier leur planning, leurs interventions
            et la remontée des informations. Je conçois et je développe moi-même vos outils,
            depuis <span class="font-medium text-zinc-900">Beauvais (Oise)</span>.
          </p>
          <div class="set-in mt-10 flex flex-wrap items-start gap-x-5 gap-y-4" style="--i:3">
            <div class="flex flex-col items-start gap-3">
              <a href="/contact/" class:list={[primaryButton, 'inline-flex']}>Prendre rendez-vous</a>
              <span class="font-mono text-xs text-zinc-500">30 min, au téléphone ou sur place</span>
            </div>
            <SocialLinks size={20} class="-ml-3 sm:ml-0" />
          </div>
        </div>

      </div>
    </div>

  </div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8 pt-8 pb-24">
    <div class="grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2">

      <div class="flex flex-col gap-16">

        <section aria-labelledby="builds-title">
          <h2 id="builds-title" class="text-xl font-semibold text-zinc-900 mb-6">Ce que je construis</h2>
          <ul class="rules">
            {needs.map(({ title, detail }) => (
              <li class="flex flex-col gap-1 py-4">
                <span class="text-sm font-medium text-zinc-900">{title}</span>
                <span class="text-sm text-zinc-500 leading-relaxed">{detail}</span>
              </li>
            ))}
          </ul>
          <p class="mt-8 text-sm text-zinc-600">Selon votre situation, deux moyens :</p>
          <div class="mt-4 grid gap-6 sm:grid-cols-2">
            {means.map(({ title, detail }) => (
              <div>
                <p class="text-sm font-medium text-zinc-900">{title}</p>
                <p class="mt-1 text-sm text-zinc-500 leading-relaxed">{detail}</p>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="steps-title">
          <div class="flex flex-wrap items-center justify-between gap-x-6 mb-6">
            <h2 id="steps-title" class="text-xl font-semibold text-zinc-900">Comment je travaille</h2>
            <a href="/offres/" class={textLink}>Voir les offres et tarifs →</a>
          </div>
          <ol class="rules">
            {steps.map(({ title, detail }, i) => (
              <li class="flex gap-4 py-4 sm:gap-6">
                <span class="w-4 shrink-0 pt-px font-mono text-xs text-zinc-500 tabular-nums" aria-hidden="true">{i + 1}</span>
                <div class="flex flex-col gap-1">
                  <span class="text-sm font-medium text-zinc-900">{title}</span>
                  <span class="text-sm text-zinc-500 leading-relaxed">{detail}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>

      </div>

      <div class="space-y-10 lg:pl-8 xl:pl-24">

        {/* Seule preuve réalisée en indépendant, anonymisée (dépôt public : aucun nom de client) */}
        <section aria-labelledby="case-title" class="rounded-2xl border border-zinc-200 p-6">
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <h2 id="case-title" class="flex items-center gap-3 text-sm font-semibold text-zinc-900">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 flex-none text-zinc-400">
                <rect x="3" y="4" width="18" height="17" rx="2" />
                <path d="M3 9h18M8 2v4M16 2v4" />
                <path d="m9 15 2 2 4-4" />
              </svg>
              Avant / après
            </h2>
            <p class="pl-8 font-mono text-xs text-zinc-500 sm:pl-0">Mission freelance, 2026</p>
          </div>
          <dl class="mt-6 space-y-5">
            <div>
              <dt class="font-mono text-xs text-zinc-500">Avant</dt>
              <dd class="mt-1.5 text-sm text-zinc-500 leading-relaxed">
                Les techniciens d'une entreprise de services jonglaient entre quatre outils
                pour planifier leurs interventions et saisir leurs temps.
              </dd>
            </div>
            <div>
              <dt class="flex items-center gap-2 font-mono text-xs text-zinc-500">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500"></span>
                Après
              </dt>
              <dd class="mt-1.5 text-sm text-zinc-900 leading-relaxed">
                Un planning de toute l'équipe sur une seule vue, une saisie des temps en quelques clics,
                les rendez-vous et les congés affichés directement.
              </dd>
            </div>
          </dl>
        </section>

        <section class="rounded-2xl border border-zinc-200 p-6">
          <h2 class="flex items-center gap-3 text-sm font-semibold text-zinc-900">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 flex-none text-zinc-400">
              <rect x="3" y="7" width="18" height="13" rx="2" />
              <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
              <path d="M3 13h18" />
            </svg>
            Parcours
          </h2>
          <ol class="mt-6 space-y-4">
            {career.map(({ title, detail, dates }) => (
              <li class="flex gap-4">
                <div class="flex-auto">
                  <p class="text-sm font-medium text-zinc-900">{title}</p>
                  <p class="mt-0.5 text-xs text-zinc-500">{detail}</p>
                </div>
                <span class="flex-none pt-0.5 font-mono text-xs text-zinc-500">{dates}</span>
              </li>
            ))}
          </ol>
          <a href="/about/" class="mt-3 -mb-3 inline-flex min-h-11 items-center text-sm text-zinc-500 hover:text-zinc-600 transition-colors">
            Voir le parcours complet →
          </a>
        </section>

        <section class="rounded-2xl border border-zinc-200 p-6">
          <h2 class="flex items-center gap-3 text-sm font-semibold text-zinc-900">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5 flex-none text-zinc-400">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m3 7 9 6 9-6" />
            </svg>
            Un projet à discuter ?
          </h2>
          <p class="mt-3 text-sm text-zinc-500 leading-relaxed">
            Décrivez votre besoin en quelques questions. Je vous rappelle sous 48 h ouvrées.
          </p>
          <a href="/contact/" class:list={[primaryButton, 'mt-6 flex w-full']}>
            Prendre rendez-vous
          </a>
        </section>

      </div>
    </div>
  </div>

</BaseLayout>
