---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm'
import Page from '../components/Page.astro'
import PageIntro from '../components/PageIntro.astro'
import { inlineLink } from '../lib/typography'

// Variable GitHub injectée au build, comme sur les mentions légales. Sans valeur, le marqueur reste et la build échoue (astro.config.mjs)
const phone = import.meta.env.LEGAL_PHONE || '[TÉLÉPHONE]'
const phoneHref = `tel:${phone.replace(/[^\d+]/g, '')}`
---

<BaseLayout
  title="Prendre rendez-vous — Maxime Derycke"
  description="Rendez-vous de découverte de 30 minutes, au téléphone ou sur place, avec Maxime Derycke, développeur à Beauvais (Oise)."
>
  <Page>
    <PageIntro title="Prendre rendez-vous">
      <p>30 minutes, au téléphone ou sur place.</p>
    </PageIntro>

    <div class="grid gap-y-12 border-t border-zinc-100 pt-12 lg:grid-cols-12 lg:gap-x-8 lg:pt-16">
      <div class="lg:col-span-6">
        <ContactForm client:load />
      </div>

      <aside class="space-y-3 text-sm leading-relaxed text-zinc-500 lg:col-span-4 lg:col-start-9">
        <p class="font-medium text-zinc-900">Je vous rappelle sous 48 h ouvrées pour fixer le rendez-vous.</p>
        <p>
          Vous préférez écrire directement ?
          <a href="mailto:maxime@mdigitalstudio.fr" class={inlineLink}>maxime@mdigitalstudio.fr</a>
        </p>
        <p>
          Ou appelez-moi :
          <a href={phoneHref} class={`${inlineLink} whitespace-nowrap`}>{phone}</a>
        </p>
      </aside>
    </div>
  </Page>
</BaseLayout>
