---
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm'
---

<BaseLayout
  title="Contact — Maxime Derycke"
  description="Démarrer un projet avec Maxime Derycke, développeur fullstack JS/TS freelance."
>
  <section class="max-w-3xl mx-auto px-6 py-16">
    <div class="mb-12">
      <h1 class="text-3xl font-semibold text-zinc-900 mb-3">Démarrer un projet</h1>
      <p class="text-zinc-500">
        Quelques questions pour mieux cerner votre besoin — cela prend 2 minutes.
      </p>
      <p class="mt-3 text-sm text-zinc-500">
        Je travaille à distance avec des clients partout en France, avec des déplacements
        ponctuels possibles en <span class="whitespace-nowrap">Île-de-France</span> et
        <span class="whitespace-nowrap">Hauts-de-France</span>.
      </p>
    </div>

    <ContactForm client:load />

    <p class="mt-12 max-w-xl border-t border-zinc-100 pt-6 text-sm text-zinc-500">
      Vous préférez écrire directement ?
      <a
        href="mailto:mderycke.pro@gmail.com"
        class="text-zinc-900 underline underline-offset-2 hover:text-zinc-600 transition-colors"
      >mderycke.pro@gmail.com</a>
    </p>
  </section>
</BaseLayout>
