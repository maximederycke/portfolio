---
import '../styles/global.css'
import { getImage } from 'astro:assets'
import SocialLinks from '../components/SocialLinks.astro'
import { avatar } from '../lib/avatar'
// Fichier latin de DM Sans, préchargé pour éviter le changement de police au premier affichage
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Développeur Fullstack JS/TS freelance' } = Astro.props

// L'offre d'abord : c'est ce que vient chercher le dirigeant de PME. Pas de lien
// « Contact » : le bouton « Prendre rendez-vous » de l'en-tête y mène sur toutes les pages
const navLinks = [
  { href: '/offres/', label: 'Offres & tarifs' },
  { href: '/about/', label: 'À propos' },
]

// Renfort technique : hors du menu principal, seulement ici (public secondaire)
const footerLinks = [
  { href: '/renfort/', label: 'Renfort technique' },
  { href: '/mentions-legales/', label: 'Mentions légales' },
  { href: '/confidentialite/', label: 'Confidentialité' },
]

const currentPath = Astro.url.pathname
const isHome = currentPath === '/'
const isContact = currentPath.startsWith('/contact/')

// Partage (LinkedIn, Malt, messageries) : URL canonique + image carrée tirée du portrait
const canonical = new URL(currentPath, Astro.site).href
const ogImage = avatar
  ? new URL((await getImage({ src: avatar, width: 1200, height: 1200, format: 'jpeg' })).src, Astro.site).href
  : new URL('/apple-touch-icon.png', Astro.site).href
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maxime Derycke" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Portrait de Maxime Derycke" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <script defer src="https://analytics.mdigitalstudio.fr/script.js" data-website-id="95f5f130-9f60-4c4c-abad-c1a1485086b6"></script>
    <title>{title}</title>
  </head>
  <body class="bg-zinc-50 text-zinc-900 min-h-screen flex flex-col">

    <a
      href="#contenu"
      class="sr-only rounded-lg bg-white px-4 py-3 text-sm font-medium text-zinc-900 ring-1 ring-zinc-900/10 focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-30"
    >
      Aller au contenu
    </a>

    <!-- En-tête : une barre flottante sur la grille de la feuille. Retrait et padding
         s'additionnent (12 + 12 px, puis 16 + 16 px dès lg) pour poser le nom sur la
         même verticale que le contenu des pages (px-6, lg:px-8 dans la feuille).
         Sous lg, la page est blanche jusqu'au bord : un fondu blanc masque le texte qui
         défile au-dessus de la barre. -->
    <header id="site-header" class="site-header group/header fixed inset-x-0 top-0 z-20 max-lg:bg-linear-to-b max-lg:from-white max-lg:from-40% max-lg:to-white/0">
      <div class="mx-auto max-w-7xl px-3 pt-3 lg:px-12 lg:pt-4">
        <div class="rounded-2xl bg-white/90 px-3 transition-colors duration-300 group-data-open/header:bg-white shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-sm lg:px-4">
          <div class="flex h-14 items-center gap-6">

            <a href="/" aria-current={isHome ? 'page' : undefined} class="inline-flex min-h-11 items-center text-[0.9375rem] font-semibold tracking-tight whitespace-nowrap text-zinc-900">
              Maxime Derycke
            </a>

            <!-- Survol d'un lien : un filet d'encre se trace de gauche à droite dessous -->
            <nav aria-label="Navigation principale" class="hidden sm:block">
              <ul class="flex text-sm font-medium">
                {navLinks.map(({ href, label }) => {
                  const isActive = currentPath.startsWith(href)
                  return (
                    <li>
                      <a
                        href={href}
                        aria-current={isActive ? 'page' : undefined}
                        class:list={['group/link relative inline-flex min-h-11 items-center px-3 whitespace-nowrap transition-colors duration-200', isActive ? 'text-teal-700' : 'text-zinc-600 hover:text-zinc-900']}
                      >
                        {label}
                        {isActive ? (
                          <span class="nav-marker absolute inset-x-1 bottom-1.5 h-px bg-linear-to-r from-teal-500/0 via-teal-500/60 to-teal-500/0" />
                        ) : (
                          <span aria-hidden="true" class="absolute inset-x-3 bottom-2.5 h-px origin-left scale-x-0 bg-zinc-900/25 transition-transform duration-300 ease-out group-hover/link:scale-x-100 motion-reduce:transition-none" />
                        )}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </nav>

            <div class="ml-auto flex items-center">
              <!-- Zone cliquable portée à 44 px par un pseudo-élément, bouton visible de 36 px -->
              <a
                href="/contact/"
                aria-current={isContact ? 'page' : undefined}
                class="group/cta relative hidden h-9 items-center gap-1.5 rounded-lg bg-zinc-900 pr-3 pl-3.5 text-sm font-medium whitespace-nowrap text-white transition-colors duration-200 before:absolute before:-inset-y-1 before:inset-x-0 hover:bg-zinc-700 active:translate-y-px sm:inline-flex"
              >
                Prendre rendez-vous
                <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 transition-transform duration-300 ease-out group-hover/cta:translate-x-0.5 motion-reduce:transition-none">
                  <path d="M3.5 8h9M8.75 4.25 12.5 8l-3.75 3.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>

              <!-- Mobile : icône burger qui se change en croix à l'ouverture -->
              <button
                id="menu-toggle"
                type="button"
                aria-controls="mobile-nav"
                aria-expanded="false"
                aria-label="Ouvrir le menu"
                class="-mr-1.5 inline-flex size-11 items-center justify-center rounded-lg text-zinc-800 transition-colors hover:bg-zinc-50 sm:hidden"
              >
                <span aria-hidden="true" class="relative block h-3 w-[1.125rem]">
                  <span class="absolute inset-x-0 top-0 h-[1.5px] rounded-full bg-current transition-transform duration-300 ease-out group-data-open/header:translate-y-[5.25px] group-data-open/header:rotate-45 motion-reduce:transition-none" />
                  <span class="absolute inset-x-0 bottom-0 h-[1.5px] rounded-full bg-current transition-transform duration-300 ease-out group-data-open/header:-translate-y-[5.25px] group-data-open/header:-rotate-45 motion-reduce:transition-none" />
                </span>
              </button>
            </div>

          </div>

          <!-- Menu mobile : la barre s'agrandit vers le bas, elle reste visible au-dessus.
               Fermé, le panneau est inerte (hors du parcours clavier et des lecteurs d'écran). -->
          <div
            id="mobile-nav"
            inert
            class="grid grid-rows-[0fr] opacity-0 transition-[grid-template-rows,opacity] duration-300 ease-out group-data-open/header:grid-rows-[1fr] group-data-open/header:opacity-100 motion-reduce:transition-none sm:hidden"
          >
            <div class="overflow-hidden">
              <nav aria-label="Menu mobile" class="border-t border-zinc-100 pt-2 pb-3">
                <ul class="text-base text-zinc-800">
                  {[{ href: '/', label: 'Accueil' }, ...navLinks].map(({ href, label }) => {
                    const isActive = href === '/' ? isHome : currentPath.startsWith(href)
                    return (
                      <li>
                        <a
                          href={href}
                          aria-current={isActive ? 'page' : undefined}
                          class:list={['flex min-h-12 items-center gap-2.5', isActive && 'font-semibold text-zinc-900']}
                        >
                          {isActive && <span aria-hidden="true" class="size-1.5 rounded-full bg-teal-500" />}
                          {label}
                        </a>
                      </li>
                    )
                  })}
                </ul>
                <a
                  href="/contact/"
                  aria-current={isContact ? 'page' : undefined}
                  class="mt-3 flex min-h-11 w-full items-center justify-center gap-1.5 rounded-lg bg-zinc-900 text-sm font-medium text-white transition-colors hover:bg-zinc-700"
                >
                  Prendre rendez-vous
                  <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4">
                    <path d="M3.5 8h9M8.75 4.25 12.5 8l-3.75 3.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Voile derrière le menu mobile ouvert : un clic dessus ferme le menu -->
    <div
      id="menu-scrim"
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-10 bg-zinc-800/20 opacity-0 backdrop-blur-[2px] transition-opacity duration-300 ease-out motion-reduce:transition-none sm:hidden"
    ></div>

    <!-- La feuille : page blanche à filets fins posée sur le fond zinc-50 (dès lg) -->
    <div class="mx-auto flex w-full max-w-7xl flex-1 lg:px-8">
      <div class="flex w-full flex-col overflow-hidden bg-white lg:ring-1 lg:ring-zinc-100">
        <main id="contenu" tabindex="-1" class="flex-1 pt-16 focus:outline-none">
          <slot />
        </main>

        <footer class="border-t border-zinc-100 py-8">
          <!-- Sous sm : © et icônes sur la première ligne, liens du pied de page sur toute la largeur dessous -->
          <!-- Points de séparation en CSS, avec un texte alternatif vide pour ne pas être lus -->
          <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-wrap items-center justify-between sm:justify-start text-xs font-mono text-zinc-500">
            <p>© {new Date().getFullYear()} Maxime Derycke</p>
            <nav aria-label="Pied de page" class="order-last w-full sm:order-none sm:w-auto sm:mr-auto sm:flex sm:items-center sm:before:content-['·'_/_''] sm:before:px-2 sm:before:text-zinc-400">
              <!-- Sous sm, les liens passent à la ligne (un espace les sépare, les points reviennent dès sm) ;
                   Renfort technique prend sa ligne pour que les deux liens légaux tiennent ensemble sur la suivante -->
              <ul class="flex flex-wrap gap-x-4 sm:gap-x-0">
                {footerLinks.map(({ href, label }, i) => (
                  <li class:list={['flex items-center', i === 0 && 'w-full sm:w-auto', i > 0 && "sm:before:content-['·'_/_''] sm:before:px-2 sm:before:text-zinc-400"]}>
                    <a
                      href={href}
                      aria-current={currentPath.startsWith(href) ? 'page' : undefined}
                      class="inline-flex min-h-11 items-center whitespace-nowrap hover:text-zinc-600 transition-colors"
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <SocialLinks size={18} class="-mr-3" />
          </div>
        </footer>
      </div>
    </div>

  </body>
</html>

<script>
  // Menu mobile : panneau de type « disclosure » attaché à la barre (pas de modale),
  // pour que la barre reste visible et que le panneau se déplie en douceur.
  const header = document.getElementById('site-header')
  const toggle = document.getElementById('menu-toggle')
  const panel = document.getElementById('mobile-nav')
  const scrim = document.getElementById('menu-scrim')

  const setOpen = (open: boolean) => {
    if (!header || !toggle || !panel || !scrim) return
    header.toggleAttribute('data-open', open)
    panel.inert = !open
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu')
    scrim.classList.toggle('opacity-100', open)
    scrim.classList.toggle('pointer-events-auto', open)
    document.body.classList.toggle('overflow-hidden', open)
  }
  const isOpen = () => header?.hasAttribute('data-open') ?? false

  toggle?.addEventListener('click', () => setOpen(!isOpen()))
  scrim?.addEventListener('click', () => setOpen(false))
  panel?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)))

  // Échap ferme et rend le focus au bouton
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && isOpen()) {
      setOpen(false)
      toggle?.focus()
    }
  })

  // Passage en largeur sm : le panneau n'existe plus, on le referme
  matchMedia('(min-width: 40rem)').addEventListener('change', event => {
    if (event.matches) setOpen(false)
  })
</script>
