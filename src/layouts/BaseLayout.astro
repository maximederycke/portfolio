---
import '../styles/global.css'
import { Image } from 'astro:assets'
import SocialLinks from '../components/SocialLinks.astro'
import { avatar } from '../lib/avatar'

interface Props {
  title: string
  description?: string
}

const { title, description = 'Développeur Fullstack JS/TS freelance' } = Astro.props

const navLinks = [
  { href: '/about', label: 'À propos' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
]

const currentPath = Astro.url.pathname
const isHome = currentPath === '/'
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <script defer src="https://analytics.mdigitalstudio.fr/script.js" data-website-id="95f5f130-9f60-4c4c-abad-c1a1485086b6"></script>
    <title>{title}</title>
  </head>
  <body class="bg-zinc-50 text-zinc-900 min-h-screen flex flex-col">

    <header class="pointer-events-none fixed inset-x-0 top-0 z-10 pt-5 pb-2">
      <div class="mx-auto max-w-7xl lg:px-8">
        <div class="relative flex items-center gap-4 px-6 lg:px-8">

          <!-- Gauche : retour à l'accueil (masqué sur l'accueil, où l'avatar est dans le hero) -->
          <div class="flex flex-1">
            {!isHome && (
              <a
                href="/"
                aria-label="Accueil"
                class="pointer-events-auto h-10 w-10 rounded-full bg-white/90 p-0.5 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-sm"
              >
                {avatar ? (
                  <Image src={avatar} alt="" width={72} height={72} class="size-9 rounded-full bg-zinc-100 object-cover" />
                ) : (
                  <span class="flex size-9 items-center justify-center rounded-full bg-zinc-100 text-sm font-semibold text-zinc-900">M</span>
                )}
              </a>
            )}
          </div>

          <!-- Centre (desktop) : pilule de navigation. Droite (mobile) : bouton Menu -->
          <div class="flex flex-1 justify-end sm:justify-center">
            <button
              id="menu-toggle"
              type="button"
              aria-haspopup="dialog"
              aria-controls="mobile-nav"
              aria-expanded="false"
              class="group pointer-events-auto flex items-center rounded-full bg-white/90 px-4 py-2 text-sm font-medium text-zinc-800 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-sm sm:hidden"
            >
              Menu
              <svg viewBox="0 0 8 6" aria-hidden="true" class="ml-3 h-auto w-2 stroke-zinc-500 group-hover:stroke-zinc-700">
                <path d="M1.75 1.75 4 4.25l2.25-2.5" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <nav aria-label="Navigation principale" class="pointer-events-auto hidden sm:block">
              <ul class="flex rounded-full bg-white/90 px-3 text-sm font-medium text-zinc-700 shadow-lg shadow-zinc-800/5 ring-1 ring-zinc-900/5 backdrop-blur-sm">
                {navLinks.map(({ href, label }) => {
                  const isActive = currentPath.startsWith(href)
                  return (
                    <li>
                      <a
                        href={href}
                        aria-current={isActive ? 'page' : undefined}
                        class:list={['relative block px-3 py-2 transition hover:text-teal-500', isActive && 'text-teal-500']}
                      >
                        {label}
                        {isActive && (
                          <span class="absolute inset-x-1 -bottom-px h-px bg-linear-to-r from-teal-500/0 via-teal-500/40 to-teal-500/0" />
                        )}
                      </a>
                    </li>
                  )
                })}
              </ul>
            </nav>
          </div>

          <!-- Droite (desktop) : espace qui garde la pilule centrée -->
          <div class="hidden sm:flex sm:flex-1"></div>

        </div>
      </div>
    </header>

    <!-- Menu mobile : panneau modal (focus piégé et Échap gérés par <dialog>) -->
    <dialog
      id="mobile-nav"
      aria-labelledby="mobile-nav-title"
      class="fixed inset-x-4 top-8 bottom-auto m-0 w-auto max-w-none rounded-3xl bg-white p-8 text-zinc-800 ring-1 ring-zinc-900/5 backdrop:bg-zinc-800/40 backdrop:backdrop-blur-xs sm:hidden"
    >
      <div class="flex flex-row-reverse items-center justify-between">
        <button type="button" data-close aria-label="Fermer le menu" class="-m-1 p-1">
          <svg viewBox="0 0 24 24" aria-hidden="true" class="h-6 w-6 text-zinc-500">
            <path d="m17.25 6.75-10.5 10.5M6.75 6.75l10.5 10.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <h2 id="mobile-nav-title" class="text-sm font-medium text-zinc-600">Navigation</h2>
      </div>
      <nav aria-label="Menu mobile" class="mt-6">
        <ul class="-my-2 divide-y divide-zinc-100 text-base text-zinc-800">
          {navLinks.map(({ href, label }) => {
            const isActive = currentPath.startsWith(href)
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={['block py-2', isActive && 'font-semibold text-zinc-900']}
                >
                  {label}
                </a>
              </li>
            )
          })}
        </ul>
      </nav>
    </dialog>

    <!-- La feuille : page blanche à filets fins posée sur le fond zinc-50 (dès lg) -->
    <div class="mx-auto flex w-full max-w-7xl flex-1 lg:px-8">
      <div class="flex w-full flex-col overflow-hidden bg-white lg:ring-1 lg:ring-zinc-100">
        <main class="flex-1 pt-16">
          <slot />
        </main>

        <footer class="border-t border-zinc-100 py-8">
          <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between">
            <p class="text-xs font-mono text-zinc-500">
              © {new Date().getFullYear()} Maxime Derycke
            </p>
            <SocialLinks size={18} class="-mr-3" />
          </div>
        </footer>
      </div>
    </div>

  </body>
</html>

<script>
  const toggle = document.getElementById('menu-toggle')
  const dialog = document.getElementById('mobile-nav') as HTMLDialogElement | null

  toggle?.addEventListener('click', () => {
    dialog?.showModal()
    toggle.setAttribute('aria-expanded', 'true')
  })

  const close = () => dialog?.close()
  dialog?.querySelectorAll('[data-close], a').forEach(el => el.addEventListener('click', close))

  // Clic sur le fond (hors du panneau) : ferme
  dialog?.addEventListener('click', event => {
    const r = dialog.getBoundingClientRect()
    const outside =
      event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom
    if (outside) close()
  })

  dialog?.addEventListener('close', () => toggle?.setAttribute('aria-expanded', 'false'))
</script>
