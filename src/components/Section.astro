---
// Section de page interne. Dès lg : titre dans le tiers gauche (il reste visible au
// défilement), contenu dans les deux tiers droits ; un filet sépare les sections.
// Le slot `aside` place un élément sous le titre (ex. un schéma).
// `wide` : titre au-dessus et contenu sur toute la largeur, pour le bloc signature
// d'une page (un bloc qui a besoin de place, comme le parcours de /offres/).
import { h2 } from '../lib/typography'

interface Props {
  title: string
  wide?: boolean
}

const { title, wide = false } = Astro.props
---

{wide ? (
  <section class="border-t border-zinc-100 py-12 lg:py-16">
    <h2 class={h2}>{title}</h2>
    <slot name="aside" />
    <div class="mt-8 lg:mt-12">
      <slot />
    </div>
  </section>
) : (
  <section class="grid gap-y-6 border-t border-zinc-100 py-12 lg:grid-cols-12 lg:gap-x-8 lg:py-16">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <h2 class={h2}>{title}</h2>
        <slot name="aside" />
      </div>
    </div>
    <div class="min-w-0 lg:col-span-8">
      <slot />
    </div>
  </section>
)}
