---
// Section de page interne. Dès lg : titre dans le tiers gauche (il reste visible au
// défilement), contenu dans les deux tiers droits ; un filet sépare les sections.
// Le slot `aside` place un élément sous le titre (ex. un schéma).
import { h2 } from '../lib/typography'

interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="grid gap-y-6 border-t border-zinc-100 py-12 lg:grid-cols-12 lg:gap-x-8 lg:py-16">
  <div class="lg:col-span-4">
    <div class="lg:sticky lg:top-28">
      <h2 class={h2}>{title}</h2>
      <slot name="aside" />
    </div>
  </div>
  <div class="min-w-0 lg:col-span-8">
    <slot />
  </div>
</section>
