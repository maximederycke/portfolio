---
// Colonne des pages internes : composée à gauche sur la grille de la feuille (px-6, lg:px-8),
// sur la même verticale que le nom dans l'en-tête. Les sections sont espacées de 4rem.
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<section class="px-6 pt-16 pb-24 lg:px-8">
  <div class:list={['max-w-3xl space-y-16', className]}>
    <slot />
  </div>
</section>
