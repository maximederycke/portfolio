---
import LinkedIn from './icons/LinkedIn.astro'
import Malt from './icons/Malt.astro'
import GitHub from './icons/GitHub.astro'

interface Props {
  size?: number
  class?: string
}

const { size = 20, class: className } = Astro.props

const linkClass =
  'inline-flex size-11 items-center justify-center text-zinc-500 hover:text-zinc-600 transition-colors'
---

<div class:list={['flex items-center', className]}>
  <a href="https://www.linkedin.com/in/maximederycke" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class={linkClass}>
    <LinkedIn size={size} />
  </a>
  <a href="https://www.malt.fr/profile/maximederycke" target="_blank" rel="noopener noreferrer" aria-label="Malt" class={linkClass}>
    <Malt size={size} />
  </a>
  <a href="https://github.com/maximederycke" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class={linkClass}>
    <GitHub size={size} />
  </a>
</div>
