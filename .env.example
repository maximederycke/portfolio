# URL de la Serverless Function Scaleway
# En local : pointer vers le serveur de dev de l'API (pnpm dev dans api/)
# En prod : URL fournie par Scaleway après déploiement
PUBLIC_API_URL=http://localhost:8080/api/contact

# Coordonnées affichées dans les mentions légales (variables GitHub en CI)
# Vides : la page affiche des marqueurs en dev et `pnpm build` échoue
LEGAL_ADDRESS=
LEGAL_PHONE=
